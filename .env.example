# Copy to .env (gitignored):  cp .env.example .env
# macOS: make env builds .env from keychain items S4R-demo + splunkbase instead.
# Fill in values — never commit .env.
# Image and timezone: config.env (not this file).
# Docker Compose receives these via make up. Required for Splunkbase downloads.

SPLUNK_ADMIN_PASSWORD=

# Splunkbase (splunkbase.splunk.com) — same account you use to download apps in the browser
SPLUNKBASE_USER=
SPLUNKBASE_PASS=

# Required: password of the Splunk user splunker (the non-admin MCP execution user).
# This repo does not write it elsewhere.
SPLUNK_SPLUNKER_PASSWORD=
