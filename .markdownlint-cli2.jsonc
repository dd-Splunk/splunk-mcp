{
  // Scope: project documentation only (not editor rule copies under .cursor / .windsurf)
  "config": ".markdownlint.json",
  "globs": [
    "docs/**/*.md",
    "README.md",
    "AGENTS.md",
    ".github/**/*.md",
    "demo-slides/**/*.md"
  ],
  "ignores": [
    "demo-slides/index.md"
  ],
  "configOverrides": [
    {
      "globs": ["demo-slides/s4r-demo-slides.md", "docs/s4r/SPL-CATALOG.md"],
      "config": {
        "MD025": false
      }
    }
  ]
}
