# Environment files (contain secrets)
.env

# Leftover local files from older checkouts. The stack does not read or write these.
.secrets/
*.token
tpl.env

# Maintainer-only machine hooks (Git credential helpers, etc.). Not part of the PoC.
scripts/local/

# Claude configuration
.claude/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Machine-local Compose override (written by scripts/cloud-bootstrap.sh)
docker-compose.override.yml

# Claude Code project MCP config — written by make update-mcp-client MCP_CLIENT=claude-code with a live token.
.mcp.json

# Cursor — mcp.json may contain secrets; rules are local. Agent prompts and skills are tracked.
.cursor/mcp.json
**/.cursor/rules/*
!**/.cursor/agents/**

# Windsurf local rules (any path in repo)
**/.windsurf/rules/

# Python bytecode (tests import SA-S4R/bin modules)
__pycache__/

# Editor directories
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
*.tmp
.*.tmp

# Splunk app local/ — instance overrides; not part of the packaged app
SA-S4R/local/**
*.lic
**/metadata/local.meta


# Certificates and key material
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.csr
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.p8
