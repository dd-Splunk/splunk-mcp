# Environment files (contain secrets)
.env
# Local copy of tpl.env.example — edit op:// paths here (never commit)
tpl.env

# Leftover local files from older checkouts. The stack does not read or write these.
.secrets/
*.token

# Maintainer-only machine hooks (Git credential helpers, etc.). Not part of the PoC.
scripts/local/

# Claude configuration
.claude/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Docker volumes (data stored in named volumes)
docker-compose.override.yml

# Cursor — mcp.json may contain secrets; rules are local. Agent prompts and skills are tracked.
.cursor/mcp.json
**/.cursor/rules/*
!**/.cursor/agents/**

# Node dependencies for local build contexts
# Cursor / Windsurf local rules (any path in repo)
**/.windsurf/rules/

# Editor directories
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Temporary files
*.tmp
.*.tmp

# Splunk app local/ — ignore everything except tracked workshop README
SA-S4R/local/**
!SA-S4R/local/README
*.lic
**/metadata/local.meta

