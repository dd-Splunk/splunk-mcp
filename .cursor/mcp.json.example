{
  "mcpServers": {
    "splunk-mcp-server": {
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://localhost:8089/services/mcp",
        "--header-file",
        "/Users/REPLACE_ME/.config/splunk-mcp/headers"
      ],
      "command": "npx",
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  }
}
