# Splunk secrets — tracked example (commit safe)
# Copy to tpl.env (gitignored):  cp tpl.env.example tpl.env
# For plain secrets without 1Password, use .env instead: cp .env.example .env
# Then replace every op:// path with items that exist in YOUR 1Password vault.
# Image and timezone: config.env (not this file).
# See docs/poc/INSTALLATION.md § "1Password Setup" and docs/poc/PRESALES.md.

# Do not wrap op:// in extra double-quotes; paths may include spaces (item titles).
SPLUNK_PASSWORD=op://YourVault/YourItem/password

# Splunkbase (required): account that can download apps from splunkbase.splunk.com
SPLUNKBASE_USER=op://YourVault/Splunkbase/username
SPLUNKBASE_PASS=op://YourVault/Splunkbase/password

# MCP execution user (default splunker) — required; not written to disk by this repo
SPLUNK_MCP_PASSWORD=op://YourVault/Splunk-MCP/splunker-password
